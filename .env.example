# Local MongoDB (docker-compose service, bound to 127.0.0.1)
MONGODB_URI=mongodb://127.0.0.1:27017/tosin4dev

# Discord webhook for blocked / review_ready pings (optional; leave blank to disable)
DISCORD_WEBHOOK_URL=

# Dev server bind host. Defaults to 127.0.0.1 (loopback only).
# This app has NO authentication and can spawn workspace-write agents against any
# absolute path, so an open bind lets any host on the LAN run code on this machine.
# Reach it from the Windows client (192.168.0.248) over the existing SSH session:
#   ssh -L 3141:localhost:3141 radan@192.168.0.68   → http://localhost:3141
# Only widen this on a network you control, and never before auth exists.
DEV_HOST=127.0.0.1
