# Local MongoDB (docker-compose service, bound to 127.0.0.1)
MONGODB_URI=mongodb://127.0.0.1:27017/tosin4dev

# Required local console unlock secret. Generate a long random value; never commit it.
TOSIN4DEV_AUTH_SECRET=

# Discord webhook for blocked / review_ready pings (optional; leave blank to disable)
DISCORD_WEBHOOK_URL=

# Dev server bind host. Defaults to 127.0.0.1 (loopback only).
# This app can spawn workspace-write agents against any absolute path, so an open
# bind lets any host on the LAN attempt to use this machine. Keep it loopback-only.
# Reach it from the Windows client (192.168.0.248) over the existing SSH session:
#   ssh -L 3141:127.0.0.1:3141 radan@192.168.0.68   → http://localhost:3141
# Only widen this on a network you control.
DEV_HOST=127.0.0.1
